# Copy this file to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored — never commit secrets.

# RDS password is auto-generated by Terraform (random_password resource)
# and stored in SSM Parameter Store automatically. No manual step needed.
origin_verify_secret = "CHANGE_ME"          # Generate with: openssl rand -hex 32
alert_email          = "jarod.daws@gmail.com"
github_repo          = "jarod/countyiq"
