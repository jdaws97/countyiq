{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Dagster",
      "type": "link",
      "url": "https://dagster.countyiq.net",
      "targetBlank": true
    },
    {
      "title": "Operations health",
      "type": "link",
      "url": "https://app.countyiq.net/ops/health",
      "targetBlank": true
    },
    {
      "title": "Grafana alert rules",
      "type": "link",
      "url": "/alerting/list",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What needs attention",
      "description": "Start with any red card, then use the linked system for the underlying detail.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Check the highlighted cards, then inspect service and source status below. [Open Dagster](https://dagster.countyiq.net) \u00b7 [Data health](https://app.countyiq.net/ops/health) \u00b7 [Alert rules](/alerting/list)"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services /6",
      "description": "Managed containers reporting healthy. A missing series does not count as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(countyiq_container_healthy{instance=\"countyiq-production\",job=\"countyiq/host\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Collectors /8",
      "description": "Required collectors succeeding at their last attempt. Missing collectors are not assumed healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(countyiq_monitor_collector_success{instance=\"countyiq-production\",job=\"countyiq/host\",collector=~\"containers|dagster|caddy|postgres|sources|recovery|openrouter|storage\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Source issues",
      "description": "Sources that are unhealthy or stale; collection absence is represented by the collector card.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum((1 - countyiq_source_healthy{instance=\"countyiq-production\",job=\"countyiq/host\"} + countyiq_source_stale{instance=\"countyiq-production\",job=\"countyiq/host\"}) > bool 0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backup age",
      "description": "Age of the latest verified backup. Check recovery status and logs if this is stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "time() - countyiq_backup_last_success_timestamp_seconds{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "red",
                "value": 108000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Root disk free",
      "description": "Free space on the root filesystem. Alerting escalates below 10 GiB.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{instance=\"countyiq-production\",job=\"countyiq/host\",mountpoint=\"/\"} / 1024 / 1024 / 1024",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Dagster running",
      "description": "Dagster runs in STARTING or STARTED; run ages appear below. Native CLI backfills are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(countyiq_dagster_runs{instance=\"countyiq-production\",job=\"countyiq/host\",status=~\"STARTING|STARTED\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "value"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Dagster queued",
      "description": "Dagster runs waiting in the queue; queue age appears below. Native CLI backfills are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(countyiq_dagster_runs{instance=\"countyiq-production\",job=\"countyiq/host\",status=\"QUEUED\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Dagster failed/24h",
      "description": "Failures reported by Dagster in the last 24 hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "countyiq_dagster_failures_24h{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 23,
      "type": "bargauge",
      "title": "External readiness \u2014 two locations",
      "description": "Authenticated HTTP 200 and database readiness every five minutes. Missing probe data is alerted separately after 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "expr": "min by (probe) (last_over_time(probe_success{job=\"countyiq-readiness\",instance=\"https://app.countyiq.net/api/ready\",probe=~\"NorthVirginia|Oregon\"}[10m]))",
          "legendFormat": "{{probe}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Needs attention",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "displayMode": "basic"
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Service status",
      "description": "Every managed service must report healthy. Missing data remains missing rather than healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "countyiq_container_healthy{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Needs attention",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "displayMode": "basic"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Source status",
      "description": "Healthy and stale are independent source-state signals. Missing series are not mapped to a healthy state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "countyiq_source_healthy{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "countyiq_source_stale{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unhealthy",
                        "color": "red"
                      },
                      "1": {
                        "text": "Healthy",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Freshness"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Fresh",
                        "color": "green"
                      },
                      "1": {
                        "text": "Stale",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "source",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time #B": true,
              "instance": true,
              "job": true,
              "__name__": true,
              "Time #A": true,
              "instance #B": true,
              "job #B": true,
              "__name__ #B": true
            },
            "indexByName": {
              "source": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "source": "Source",
              "Value #A": "Health",
              "Value #B": "Freshness"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Collector result",
      "description": "Last result for each required collection task. Freshness is shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "countyiq_monitor_collector_success{instance=\"countyiq-production\",job=\"countyiq/host\",collector=~\"containers|dagster|caddy|postgres|sources|recovery|openrouter|storage\"}",
          "legendFormat": "{{collector}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Succeeded",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "displayMode": "basic"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Collector attempt age",
      "description": "Seconds since each collector last attempted work. Storage runs hourly; the rest normally run more often.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - countyiq_monitor_last_attempt_timestamp_seconds{instance=\"countyiq-production\",job=\"countyiq/host\",collector=~\"containers|dagster|caddy|postgres|sources|recovery|openrouter|storage\"}",
          "legendFormat": "{{collector}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Dagster pipeline status counts",
      "description": "Dagster run counts by status. Ages are intentionally shown in the neighboring panel; native CLI backfills are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "countyiq_dagster_runs{instance=\"countyiq-production\",job=\"countyiq/host\"}",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Oldest Dagster pipeline run age",
      "description": "Dagster run age by status; queued runs above 30 minutes and running runs above six hours need review. Native CLI backfills are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "countyiq_dagster_oldest_run_seconds{instance=\"countyiq-production\",job=\"countyiq/host\",status=~\"QUEUED|STARTING|STARTED\"}",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Root disk free",
      "description": "Free root filesystem capacity over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${METRICS_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{instance=\"countyiq-production\",job=\"countyiq/host\",mountpoint=\"/\"} / 1024 / 1024 / 1024",
          "legendFormat": "free",
          "refId": "A"
        }
