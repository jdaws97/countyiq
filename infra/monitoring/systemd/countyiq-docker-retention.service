[Unit]
Description=CountyIQ old release image and build cache retention
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/countyiq-monitoring/.venv/bin/python /opt/countyiq-monitoring/retention.py --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lock
MemoryMax=128M
CPUQuota=25%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=45min
