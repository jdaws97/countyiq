# Actual values belong in infra/secrets/monitoring.sops.env, never this file.
# Use the actual Free plan. No billing/upgrade API is used by this project.
GRAFANA_STACK_URL=https://YOUR-STACK.grafana.net
GRAFANA_METRICS_URL=https://prometheus-prod-REGION.grafana.net/api/prom/push
GRAFANA_METRICS_USER=YOUR-METRICS-INSTANCE-ID
GRAFANA_LOGS_URL=https://logs-prod-REGION.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=YOUR-LOGS-INSTANCE-ID
GRAFANA_INGEST_TOKEN=SET-IN-PROTECTED-PROMPT
# Provisioning token stays off the VPS; needs dashboard/alert provisioning rights.
GRAFANA_PROVISION_TOKEN=SET-IN-PROTECTED-PROMPT
COUNTYIQ_OPERATOR_EMAIL=jarod.daws@gmail.com
