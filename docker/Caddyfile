{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 2m
		}
		max_header_size 32KB
		# Cloudflare's published ranges, verified 2026-08-30. Requests from
		# any other peer cannot supply a trusted client address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN:localhost} {
	header {
		-Server
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Collapse the validated proxy chain to one value for Uvicorn and
			# remove the vendor header so the app never has two authorities.
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
		}
	}

	# Default: return 404 for non-API requests
	# Frontend is served by Cloudflare Pages, not this VPS
	handle {
		respond 404
	}
}
