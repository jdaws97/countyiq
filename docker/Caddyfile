{
	# Scraped through the container's loopback admin endpoint by the host probe.
	# No public metrics route, URL labels, or customer identifiers are exposed.
	metrics
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 2m
		}
		max_header_size 32KB
		# The origin is not publicly reachable. Only the dedicated cloudflared
		# bridge may supply Cloudflare's authenticated client-address header.
		trusted_proxies static 172.31.253.0/24
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

# Shared static files contain no customer data. Each host has its own HTML entry.
(static_assets) {
	# Missing chunks must be 404s, never a year-cached HTML fallback.
	handle /assets/* {
		root * /srv
		@existing file {path}
		handle @existing {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			header Cache-Control "no-store"
			respond 404
		}
	}
}

:8080 {
	encode zstd gzip
	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; img-src 'self' data: blob: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@health path /healthz
	handle @health {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	@marketing host {$DOMAIN:countyiq.net}
	handle @marketing {
		@api path /api /api/*
		handle @api {
			header Cache-Control "no-store"
			respond 404
		}
		import static_assets
		@public_page path / /index.html /favicon-ciq.svg /robots.txt
		handle @public_page {
			root * /srv
			header Cache-Control "no-cache"
			file_server
		}
		@entry path /app /app.html
		handle @entry {
			redir https://app.{$DOMAIN:countyiq.net}/ 302
		}
		handle {
			# Preserve old product deep links; never proxy them on the public host.
			redir https://app.{$DOMAIN:countyiq.net}{uri} 302
		}
	}

	@product host app.{$DOMAIN:countyiq.net}
	handle @product {
		header X-Robots-Tag "noindex, nofollow"
		@api path /api /api/*
		handle @api {
			header Cache-Control "no-store"
			reverse_proxy api:8000 {
				header_up X-Forwarded-For {client_ip}
				header_up -CF-Connecting-IP
			}
		}
		import static_assets
		@favicon path /favicon-ciq.svg
		handle @favicon {
			root * /srv
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			root * /srv
			rewrite * /app.html
			file_server
		}
	}

	handle {
		respond 404
	}
}
