# Copy this file to <county-key>.toml. The filename becomes COUNTY=<county-key>.
# Required values establish the parcel anchor; every other source is optional
# and may be added as its reuse status and schema are verified.

name = "Example County"
state = "PA"
open_data_source_key = "example_open_data"
plcb_filter = "Example County"
arcgis_parcels_url = "https://gis.example.gov/arcgis/rest/services/OpenData/Parcels/FeatureServer/0"
s3_prefix = "example"

# Truncation guards must be calibrated from a successful source inventory.
plcb_min_records = 100
arcgis_parcels_min_records = 10000

# Statewide/federal sources are configured once per county with county filters.
penndot_roads_url = "https://gis.penndot.gov/arcgis/rest/services/opendata/roadwaysegments/MapServer/0"
penndot_roads_cty_code = "00"
penndot_projects_url = "https://gis.penndot.gov/arcgis/rest/services/paprojects/paprojects/MapServer"
penndot_projects_county_filter = "EXAMPLE"
fema_nfhl_url = "https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer"
fema_dfirm_id = "42000C"

# Statewide PA DEP diligence sources become active when a county envelope is
# supplied as [west, south, east, north]. Calibrate both row guards from a
# successful inventory before enabling a new county.
pa_dep_query_bbox = [-77.6, 39.7, -76.8, 40.2]
pa_dep_storage_tanks_min_records = 50
pa_dep_cleanup_sites_min_records = 50

# Array rows are [dataset_id, county_field, county_value, record_id_field].
soda_datasets = [
  ["xvd7-5r2c", "shortcountyname", "Example", ":id"],
]

# Municipal proceedings are the differentiated local layer. Add only official
# pages whose access/reuse status and actual document coverage were checked.
municipality_websites = [
  ["Example Township Planning Commission", "https://example.gov/planning/minutes", "planning_commission"],
  ["Example Township Zoning Hearing Board", "https://example.gov/zoning/minutes", "zoning_hearing"],
]
