# Database
# Updated by deploy.sh only after a ready, receipt-backed release. Keeping the
# current tag here makes later `docker compose up` operations deterministic.
COUNTYIQ_IMAGE_TAG=local
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=countyiq
DATABASE_USER=dagster_admin
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://dagster_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/countyiq
# Normal Dagster runs use this non-superuser writer. The admin login above is
# reserved for migrations, role refresh, and backups.
DATABASE_PIPELINE_USER=countyiq_pipeline
DATABASE_PIPELINE_PASSWORD=CHANGE_ME_PIPELINE_PASSWORD
# The public API receives only this read-only login, never the migration/admin
# credential above.  setup.sh generates an independent 64-character secret.
DATABASE_API_USER=countyiq_api
DATABASE_API_PASSWORD=CHANGE_ME_API_PASSWORD
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=8
DATABASE_POOL_WAIT_SECONDS=5
# Per-worker cache window for the source health response.
COUNTYIQ_OPS_HEALTH_TTL=60

# County deployment identity. Each county uses a separate stack/database.
COUNTY=york
# COUNTYIQ_COUNTY_NAME=York County
COUNTYIQ_COUNTY_STATE=PA
COUNTYIQ_PRODUCT_STAGE=alpha
COUNTYIQ_OPEN_DATA_SOURCE_KEY=york_open_data
# Optional directory containing additional validated <county-key>.toml files.
# COUNTYIQ_COUNTY_CONFIG_DIR=/opt/countyiq/counties

# Dagster
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_USER=dagster_admin
DAGSTER_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Slack webhooks
SLACK_WEBHOOK_CRITICAL=
SLACK_WEBHOOK_WARNING=
SLACK_WEBHOOK_PIPELINE=

# OpenRouter / LLM harness
# Leave the model vars empty to use the evidence-backed per-pass defaults in
# pipelines/countyiq/lib/pass_llm_config.py — set one only to deliberately
# override. (x-ai/grok-4.1-fast and xiaomi/mimo-v2-flash were removed here
# 2026-08-02: both slugs are deprecated/delisted on OpenRouter.)
OPENROUTER_API_KEY=
# Backend selection is global or per pass: openrouter (default) or
# codex_subscription. Subscription mode uses the signed-in native Codex CLI;
# it never falls back to paid OpenRouter calls when unavailable.
COUNTYIQ_LLM_BACKEND=openrouter
COUNTYIQ_CODEX_MODEL=gpt-6-astra
COUNTYIQ_CODEX_TIMEOUT_SECONDS=600
# Per-pass backend overrides. Leave blank to inherit COUNTYIQ_LLM_BACKEND.
COUNTYIQ_PASS0_BACKEND=
COUNTYIQ_PASS1_BACKEND=
COUNTYIQ_PASS2_BACKEND=
COUNTYIQ_PASS3_BACKEND=
COUNTYIQ_PASS4_BACKEND=
# Optional native model overrides (plain Codex model names, without a provider prefix).
COUNTYIQ_PASS0_CODEX_MODEL=
COUNTYIQ_PASS1_CODEX_MODEL=
COUNTYIQ_PASS2_CODEX_MODEL=
COUNTYIQ_PASS3_CODEX_MODEL=
COUNTYIQ_PASS4_CODEX_MODEL=
# Optional same-subscription escalation models; unset disables escalation.
COUNTYIQ_PASS0_CODEX_ESCALATION_MODEL=
COUNTYIQ_PASS1_CODEX_ESCALATION_MODEL=
COUNTYIQ_PASS2_CODEX_ESCALATION_MODEL=
COUNTYIQ_PASS3_CODEX_ESCALATION_MODEL=
COUNTYIQ_PASS4_CODEX_ESCALATION_MODEL=
# Hard native subscription call caps per pass and run. These remain finite for backfills.
COUNTYIQ_PASS0_CODEX_MAX_CALLS=100
COUNTYIQ_PASS1_CODEX_MAX_CALLS=100
COUNTYIQ_PASS2_CODEX_MAX_CALLS=100
COUNTYIQ_PASS3_CODEX_MAX_CALLS=100
COUNTYIQ_PASS4_CODEX_MAX_CALLS=100
# Private persistent device-auth home, owned by container UID/GID 10001 on the VPS.
CODEX_HOME=/opt/countyiq/codex-auth
# Host directory mounted at CODEX_HOME by docker/docker-compose.yml.
COUNTYIQ_CODEX_AUTH_DIR=/var/lib/countyiq/codex-auth
# Durable native execution receipts and state inside the mounted backfill volume.
COUNTYIQ_SUBSCRIPTION_STATE_DIR=/opt/countyiq/intelligence/subscription
COUNTYIQ_PASS0_MODEL=
COUNTYIQ_PASS1_MODEL=
COUNTYIQ_PASS2_MODEL=
COUNTYIQ_PASS3_MODEL=
COUNTYIQ_PASS4_MODEL=
# Paid passes are all opt-in. An API key alone never authorizes inference spend.
COUNTYIQ_PASS0_ENABLED=false
# Lower-cost source excerpts; structured retains the previous interpreted output.
# Evidence mode requires migration 070 and a matching quality receipt.
COUNTYIQ_PASS0_MODE=evidence
COUNTYIQ_PASS1_ENABLED=false
COUNTYIQ_PASS2_ENABLED=false
COUNTYIQ_PASS3_ENABLED=false
# records explains current public records without requiring a Pass 2 score.
# legacy retains the validated-signal parcel/owner brief path.
COUNTYIQ_PASS3_MODE=records
COUNTYIQ_PASS4_ENABLED=false
# Finite outer work-item ceilings per explicit pass run. Increase only after a
# fresh selector estimate and budget approval; zero never means unbounded.
COUNTYIQ_PASS0_MAX_ITEMS=25
COUNTYIQ_PASS1_MAX_ITEMS=25
COUNTYIQ_PASS2_MAX_ITEMS=25
COUNTYIQ_PASS3_MAX_ITEMS=25
COUNTYIQ_PASS4_MAX_ITEMS=25
# Explicit cost-only mode for an approved Pass 0-3 backfill. This ignores the
# item cap but still requires the pass dollar limit and global price ceilings.
COUNTYIQ_PASS0_BACKFILL_MODE=false
COUNTYIQ_PASS1_BACKFILL_MODE=false
COUNTYIQ_PASS2_BACKFILL_MODE=false
COUNTYIQ_PASS3_BACKFILL_MODE=false
# Every paid run requires a durable authorization file. Its
# reservation ledger persists spend across Dagster retries and restarts.
COUNTYIQ_BACKFILL_STATE_DIR=/var/lib/countyiq/intelligence
COUNTYIQ_PASS0_BACKFILL_AUTHORIZATION_FILE=
COUNTYIQ_PASS1_BACKFILL_AUTHORIZATION_FILE=
COUNTYIQ_PASS2_BACKFILL_AUTHORIZATION_FILE=
COUNTYIQ_PASS3_BACKFILL_AUTHORIZATION_FILE=
# Mandatory hard dollar ceiling for each explicitly enabled pass run. Leave
# blank while disabled; set only after reviewing the read-only estimate.
COUNTYIQ_PASS0_MAX_COST_USD=
COUNTYIQ_PASS1_MAX_COST_USD=
COUNTYIQ_PASS2_MAX_COST_USD=
# Provider calls in flight at once for Pass 2 (1-16). Database work stays
# single-threaded; the spend ledger is lock-protected.
COUNTYIQ_PASS2_CONCURRENCY=4
# Pass 3 briefs are generated only for the top-N radar parcels by the better
# of opportunity and momentum score.
COUNTYIQ_PASS3_RANK_LIMIT=500
# Additional low-score properties selected by their latest municipal record.
# The original municipal explanation remains available on every linked parcel.
COUNTYIQ_PASS3_MUNICIPAL_PROPERTY_LIMIT=1000
COUNTYIQ_PASS3_MAX_COST_USD=
COUNTYIQ_PASS4_MAX_COST_USD=
COUNTYIQ_OPENROUTER_MODEL=
COUNTYIQ_SEARCH_MODEL=
# A separately budgeted provider key restricted to interactive search.  Do not
# reuse OPENROUTER_API_KEY, which remains available only to Dagster.
COUNTYIQ_SEARCH_API_KEY=
# Explicit opt-in: a pipeline API key alone must not enable metered public search.
COUNTYIQ_SEARCH_LLM_ENABLED=false
COUNTYIQ_SEARCH_RATE_PER_MIN=10
COUNTYIQ_SEARCH_BURST=5
COUNTYIQ_SEARCH_DAILY_LLM_BUDGET=2000
# Secondary anti-scraping guard for owner/entity portfolio routes.
COUNTYIQ_SENSITIVE_RATE_PER_MIN=30
COUNTYIQ_SENSITIVE_BURST=10
# Per worker, across each limiter; bounds memory under high-cardinality IP churn.
COUNTYIQ_RATE_LIMIT_MAX_CLIENTS=10000
# Comma-separated browser origins. Production normally uses a same-origin
# reverse proxy and needs no CORS entry; set this only for a separate frontend.
# COUNTYIQ_CORS_ORIGINS=https://app.example.com
# Comma-separated Host values without schemes or paths. Set this to the public
# API hostname before production startup (for example api.countyiq.example).
COUNTYIQ_TRUSTED_HOSTS=localhost
# Public Swagger/OpenAPI routes are off by default.
COUNTYIQ_EXPOSE_API_DOCS=false
# Default-off: mount person-linked tax-distress and assemblage routes only
# after the deployment has an approved privacy/terms review and access policy.
COUNTYIQ_ENABLE_RESTRICTED_DISTRESS=false
# Strict JSON Schema is ON by default; unsupported routing fails closed.
# COUNTYIQ_STRICT_SCHEMA=false
# Optional relaxed mode includes the schema in the prompt and records fallback.
# Record explanations always require strict schema, regardless of this setting.
# COUNTYIQ_ALLOW_SCHEMA_FALLBACK=false
# Comma-separated OpenRouter provider slugs. Per-pass versions override globals,
# e.g. COUNTYIQ_PASS3_PROVIDER_ONLY. Calibration pins one provider with no fallback.
# COUNTYIQ_PROVIDER_ONLY=
# COUNTYIQ_PROVIDER_ORDER=
# COUNTYIQ_PROVIDER_ALLOW_FALLBACKS=false
# Provider price ceilings ($/M tokens) — set these when adopting any model
# whose OpenRouter rate is promotional, so an expiry can't silently 5x the bill.
COUNTYIQ_MAX_PRICE_PROMPT=
COUNTYIQ_MAX_PRICE_COMPLETION=
# COUNTYIQ_ZDR=true   # restrict routing to zero-data-retention endpoints
COUNTYIQ_PASS0_MAX_PDF_BYTES=8388608
COUNTYIQ_PASS0_PDF_TOKEN_CEILING=50000
# Escalate unresolved contradiction alerts after this age.
COUNTYIQ_CONTRADICTION_MAX_AGE_HOURS=72
# Bounded source-refresh batches; persisted rows resume the remaining backlog.
COUNTYIQ_PROCEEDINGS_MAX_DOCUMENT_REQUESTS=250
COUNTYIQ_PROCEEDINGS_MAX_DOCUMENTS_PER_BODY=25
COUNTYIQ_PROCEEDINGS_MAX_FUTURE_DAYS=90
COUNTYIQ_PA_DOS_MAX_NAMES_PER_RUN=500
COUNTYIQ_PA_DOS_FOUND_TTL_DAYS=30
COUNTYIQ_PA_DOS_NOT_FOUND_TTL_DAYS=180
# PDF parser engine for Pass 0's inline-PDF fallback. "native" (default)
# uses the model's own file input at token pricing; unpinned uploads can
# silently route to OCR at ~$2/1,000 pages (see docs/cost.md).
# COUNTYIQ_PASS0_PDF_ENGINE=native
# Optional thinking overrides. Leave unset to use the pass defaults from code.
# COUNTYIQ_THINKING=true
# COUNTYIQ_PASS1_THINKING=true
# COUNTYIQ_PASS2_THINKING=true
# Per-pass reasoning effort (low|medium|high). Pass 2 defaults to "low" in
# code (exp H); others follow the model's default.
# COUNTYIQ_PASS1_REASONING_EFFORT=high
# N-trial voting. Pass 1 uses majority pair-partition voting (stability
# probe 2026-08-06: disagreement → abstain); Pass 2 uses per-signal
# majority voting with trial_agreement persisted as confidence.
# COUNTYIQ_PASS1_TRIALS=3
# COUNTYIQ_PASS1_ADAPTIVE_VOTING=true  # skip the third vote after an irreversible 2-0 majority
# Pass 1 includes person-only name clusters because owner identity and
# assemblage are customer-visible. Set false to accept lower identity recall
# in exchange for a smaller backfill.
# COUNTYIQ_PASS1_INCLUDE_PERSON_CLUSTERS=true
# Paid identity checks prioritize plan/municipal activity, acquisition-active
# organizations, and public owners of watched properties or owner records.
# Exact PA DOS registration-name partitions run without enabling paid inference.
# Set all only for an explicitly budgeted county-wide alias backfill.
COUNTYIQ_PASS1_SCOPE=active_records
# COUNTYIQ_PASS2_TRIALS=1
# Escalation cascade: clusters the Pass 1 model ABSTAINS on are re-run
# through a stronger model (~30 clusters/mo — see docs/open-items.md).
# COUNTYIQ_PASS1_ESCALATION_MODEL=
# COUNTYIQ_PASS1_ESCALATION_REASONING_EFFORT=
# Contradiction policy (2026-09-02). Same-evidence semantic flips used to wait
# for a human one by one. Now the rule policy resolves routine flips (version
# upgrades accept the challenger; same-version noise keeps the incumbent) and
# only consequential flips (person/organization merges, approved<->denied,
# high<->non-actionable, pursue<->pass) or rule/judge disagreements stay in the
# human queue. Set false to quarantine everything for manual review.
COUNTYIQ_AUTO_RESOLVE_CONTRADICTIONS=true
# Optional judge model: when set, a routine flip resolves only if the judge
# agrees with the rule default (or is unclear). Bounded by its own dollar cap.
COUNTYIQ_JUDGE_MODEL=
COUNTYIQ_JUDGE_MAX_COST_USD=
# COUNTYIQ_JUDGE_REASONING_EFFORT=medium
# Preflight: after the first accepted run of a pass, the 20-case human receipt
# is replaced by this minimum deterministic-gate pass rate over 30 days
# (accepted / (accepted + rejected)), evaluated once 20 outputs exist.
# COUNTYIQ_PASS0_MIN_GATE_PASS_RATE=0.8
# COUNTYIQ_PASS1_MIN_GATE_PASS_RATE=0.8
# COUNTYIQ_PASS2_MIN_GATE_PASS_RATE=0.8
# COUNTYIQ_PASS3_MIN_GATE_PASS_RATE=0.8
# Where `review_intelligence_contradictions.py approve|reject` writes gold
# candidates for the eval corpus (default pipelines/eval/fixtures/candidates).
# COUNTYIQ_GOLD_CANDIDATE_DIR=
#
# Code model defaults are openai/gpt-5.6-luna for Passes 0-4; every runtime
# pass remains disabled until its explicit per-pass gate is enabled. Pass 1
# uses effort=high with N=3 voting and Pass 2 uses effort=low
# (see docs/decisions.md). Named fallbacks if luna degrades or reprices:
# COUNTYIQ_PASS2_MODEL=deepseek/deepseek-v4-flash-0731   # P2 cost fallback
# COUNTYIQ_PASS1_MODEL=minimax/minimax-m3                # cross-vendor second source
COUNTYIQ_ARCHIVE_DIR=/opt/countyiq/archives
# Durable host path; independent of the active release checkout.
COUNTYIQ_ARCHIVE_HOST_DIR=/var/lib/countyiq/archives
# PC-only alternative to R2 for governed raw source payloads. Leave unset in
# production; see docs/operations/local-intelligence-backfill.md.
COUNTYIQ_LOCAL_RAW_ARCHIVE_DIR=
COUNTYIQ_PDF_TEXT_MAX_BYTES=8388608
COUNTYIQ_PDF_TEXT_MAX_PAGES=500
# Raw model prompts/responses can contain owner and parcel evidence. The
# harness prunes matching archives daily; backup.sh applies the same limit to R2.
COUNTYIQ_LLM_ARCHIVE_RETENTION_DAYS=90

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_RAW_BUCKET=countyiq-raw
# Dedicated private bucket used by host-level PostgreSQL backups. The backup
# script configures rclone directly; no mutable per-host profile is required.
# Use a credential distinct from the Dagster raw-archive credential above so a
# compromised pipeline process cannot reach database backups.
COUNTYIQ_BACKUP_R2_ACCESS_KEY_ID=
COUNTYIQ_BACKUP_R2_SECRET_ACCESS_KEY=
COUNTYIQ_BACKUP_R2_BUCKET=countyiq-backups
# Set true only after enabling an R2 bucket-lock rule. Remote expiry belongs to
# an R2 lifecycle rule; the VPS backup credential has no scripted delete path.
COUNTYIQ_BACKUP_BUCKET_LOCK_CONFIRMED=false
# A successful drill must be this recent before an ordinary production deploy.
COUNTYIQ_RESTORE_DRILL_MAX_AGE_DAYS=120
# Required after the initial release; the exact public endpoint is checked
# after the internal container probe on every ordinary deployment.
# COUNTYIQ_PUBLIC_READY_URL=https://app.countyiq.net/api/ready
# Optional root-owned mode-0600 curl config with Access authentication headers.
# The public readiness check requires HTTP 200 and the API JSON health response.
# COUNTYIQ_PUBLIC_READY_CURL_CONFIG=/etc/countyiq/readiness.curl
# Set true in production: archive failures fail the asset run instead of
# silently dropping raw data.
COUNTYIQ_ARCHIVE_STRICT=false
# Fail a run when more than this fraction of attempted work items errors.
COUNTYIQ_ERROR_BUDGET=0.3
# Optional higher-rate-limit token for the PA open-data SODA API.
SODA_APP_TOKEN=
AWS_DEFAULT_REGION=auto

# Cloudflare Tunnel and enforced R2 storage ceiling. The tunnel token
# comes from the sensitive OpenTofu output and is mounted as a Docker secret.
CLOUDFLARE_TUNNEL_TOKEN=
# Trip at 20 GB total storage. This is a decimal byte ceiling across both
# CountyIQ R2 buckets, not an informational alert.
COUNTYIQ_R2_HARD_LIMIT_BYTES=20000000000

# Marketing hostname. The product uses app.DOMAIN. Caddy is Tunnel-only.
DOMAIN=localhost

# Private server watches; apply migration 055 and refresh API role grants first.
COUNTYIQ_WATCH_SYNC_ENABLED=false
# Version-bound quality approvals for paid Passes 0-3 (prepare_quality_receipt.py).
COUNTYIQ_PASS0_QUALITY_RECEIPT=
COUNTYIQ_PASS1_QUALITY_RECEIPT=
COUNTYIQ_PASS2_QUALITY_RECEIPT=
COUNTYIQ_PASS3_QUALITY_RECEIPT=

# Account sign-in: disabled only for local exploration.
# Production: cloudflare_access, using the app host Access application's AUD.
COUNTYIQ_AUTH_PROVIDER=disabled
# Verified human sign-in emails permitted to access operational health. Empty denies all.
COUNTYIQ_OPERATOR_EMAILS=
COUNTYIQ_ACCESS_ISSUER=
COUNTYIQ_ACCESS_AUD=
COUNTYIQ_APP_URL=
COUNTYIQ_WORKSPACE_ORIGINS=
# Production examples:
# DOMAIN=countyiq.net
# COUNTYIQ_TRUSTED_HOSTS=app.countyiq.net
# COUNTYIQ_APP_URL=https://app.countyiq.net
# COUNTYIQ_WORKSPACE_ORIGINS=https://app.countyiq.net
